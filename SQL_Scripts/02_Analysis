
CREATE VIEW dbo.vw_Supply_Chain_Analytics AS
SELECT
    f.fact_id AS Fact_ID,
    f.product_key,
    f.[PQ #] AS Price_Quote_Number,
    f.[PO / SO #] AS Purchase_Sales_Order_Number,
    f.[ASN/DN #] AS Advanced_Shipping_Notice_Delivery_Note_Number,
    p.project_code AS Project_Code,
    p.country AS Country,
    p.managed_by AS Project_Manager, 
    v.vendor_name AS Vendor_Name,
    v.manufacturing_site AS Manufacturing_Site,
    fl.fulfill_via AS Fulfillment_Method,
    fl.vendor_inco_term AS Vendor_Incoterm,
    fl.fulfillment_key AS Fulfillment_Key,
    fl.shipment_mode AS Shipment_Mode,
    prd.product_group AS Product_Group,
    prd.sub_classification AS Sub_Classification,
    prd.item_description AS Item_Description,
    prd.molecule_test_type AS Molecule_Test_Type,
    prd.brand AS Brand,
    prd.dosage AS Dosage,
    prd.dosage_form AS Dosage_Form,
    f.[PQ First Sent to Client Date] AS PQ_First_Sent_To_Client_Date,
    f.[PO Sent to Vendor Date] AS PO_Sent_To_Vendor_Date,
    f.[Scheduled Delivery Date] AS Scheduled_Delivery_Date,
    f.[Delivered to Client Date] AS Delivered_To_Client_Date,
    f.[Delivery Recorded Date] AS Delivery_Recorded_Date,
    f.[Unit of Measure (Per Pack)] AS Unit_Of_Measure_Per_Pack,
    f.[Line Item Quantity] AS Line_Item_Quantity,
    f.[First Line Designation] AS Is_First_Line_Designation,
    CAST(f.[Line Item Value] AS DECIMAL(18, 2)) AS Line_Item_Total_Value_USD,
    CAST(f.[Pack Price] AS DECIMAL(18, 2)) AS Pack_Price_USD,
    CAST(f.[Unit Price] AS DECIMAL(18, 2)) AS Unit_Price_USD,
    CAST(f.[Line Item Insurance (USD)] AS DECIMAL(18, 2)) AS Line_Item_Insurance_USD,
    TRY_CAST(f.[Weight (Kilograms)] AS DECIMAL(18, 2)) AS Weight_Kilograms,
    TRY_CAST(f.[Freight Cost (USD)] AS DECIMAL(18, 2)) AS Freight_Cost_USD,
-- total landed cost calculation: product value + freight cost + insurance (if any)
    CAST(
        f.[Line Item Value]
        + ISNULL(TRY_CAST(f.[Freight Cost (USD)] AS DECIMAL(18,2)), 0) 
        + ISNULL(f.[Line Item Insurance (USD)], 0) 
        AS DECIMAL(18, 2)
    ) AS [Total_Landed_Cost_USD],
    -- freight cost percentage of value calculation
    CAST(
        (TRY_CAST(f.[Freight Cost (USD)] AS DECIMAL(18,2)) * 100.0) 
        / NULLIF(f.[Line Item Value], 0) 
        AS DECIMAL(18, 4)
    ) AS [Freight_Cost_Percentage_Of_Value],
    -- total revenue calculation
    CAST(
        (f.[Line Item Quantity] * CAST(f.[Pack Price] AS DECIMAL(18, 2))) 
        AS DECIMAL(18,2)
    ) AS [Revenues_USD],
    -- lead time calculation
    DATEDIFF(day, f.[PO Sent to Vendor Date], f.[Delivered to Client Date]) AS [Vendor_Lead_Time_Days],
    DATEDIFF(day, f.[Scheduled Delivery Date], f.[Delivered to Client Date]) AS [Delivery_Delay_Days]
FROM 
    dbo.fact_table f
INNER JOIN dbo.dim_project p 
    ON f.project_key = p.project_key
INNER JOIN dbo.dim_vendor v 
    ON f.vendor_key = v.vendor_key
INNER JOIN dbo.dim_fulfillment fl 
    ON f.fulfillment_key = fl.fulfillment_key
INNER JOIN dbo.dim_product prd 
    ON f.product_key = prd.product_key;


-- Create view table for fulfillment
ALTER VIEW dbo.vw_Fulfillment_Analytics AS
SELECT
fulfillment_key,
fulfill_via as fulfillment_method,
vendor_inco_term,
shipment_mode,
CASE
    WHEN fulfill_via = 'Vendor Direct' THEN 'Direct'
    WHEN fulfill_via = '3PL' THEN 'Third-Party Logistics'
    ELSE 'Other'
END AS fulfillment_category
FROM
dbo.dim_fulfillment;

-- Create view table for product 
CREATE VIEW dbo.vw_Product_Analytics AS
SELECT
product_key,
product_group,  
sub_classification,
item_description,
molecule_test_type,
brand,
dosage,
dosage_form,
CASE
    WHEN product_group IN ('API', 'Excipient') THEN 'Raw Material'
    WHEN product_group IN ('Finished Goods', 'Packaging Material') THEN 'Finished/Packaging'
    ELSE 'Other'
END AS product_category
FROM
dbo.dim_product;

-- Create view table for project
CREATE VIEW dbo.vw_Project_Analytics AS
SELECT
project_key,
project_code,
country,
managed_by,
CASE
    WHEN country IN ('USA', 'Canada') THEN 'North America'
    WHEN country IN ('Germany', 'France', 'UK') THEN 'Europe'
    WHEN country IN ('China', 'India') THEN 'Asia'
    ELSE 'Other'
END AS region
FROM
dbo.dim_project;

-- Create view table for vendor
CREATE VIEW dbo.vw_Vendor_Analytics AS
SELECT
vendor_key,
vendor_name,
manufacturing_site,
CASE
    WHEN manufacturing_site IN ('USA', 'Canada') THEN 'North America'
    WHEN manufacturing_site IN ('Germany', 'France', 'UK') THEN 'Europe'
    WHEN manufacturing_site IN ('China', 'India') THEN 'Asia'
    ELSE 'Other'
END AS vendor_region
FROM
dbo.dim_vendor;

-- Create view table for fact table 
ALTER VIEW dbo.vw_Fact_Analytics AS
SELECT
fact_id,
product_key,
project_key,
vendor_key,
fulfillment_key,
[PQ #] AS price_quote_number,
[PO / SO #] AS purchase_sales_order_number,
[ASN/DN #] AS advanced_shipping_notice_delivery_note_number,
[PQ First Sent to Client Date] AS pq_first_sent_to_client_date,
[PO Sent to Vendor Date] AS po_sent_to_vendor_date,
[Scheduled Delivery Date] AS scheduled_delivery_date,
[Delivered to Client Date] AS delivered_to_client_date,
[Delivery Recorded Date] AS delivery_recorded_date,
[Unit of Measure (Per Pack)] AS unit_of_measure_per_pack,
[Line Item Quantity] AS line_item_quantity,
[First Line Designation] AS is_first_line_designation,
CAST([Line Item Value] AS DECIMAL(18, 2)) AS line_item_total_value_usd,
CAST([Pack Price] AS DECIMAL(18, 2)) AS pack_price_usd,
CAST([Unit Price] AS DECIMAL(18, 2)) AS unit_price_usd,
CAST([Line Item Insurance (USD)] AS DECIMAL(18, 2)) AS line_item_insurance_usd,
TRY_CAST([Weight (Kilograms)] AS DECIMAL(18, 2)) AS weight_kilograms,
TRY_CAST([Freight Cost (USD)] AS DECIMAL(18, 2)) AS freight_cost_usd,
  CAST(
        [Line Item Value]
        + ISNULL(TRY_CAST([Freight Cost (USD)] AS DECIMAL(18,2)), 0) 
        + ISNULL([Line Item Insurance (USD)], 0) 
        AS DECIMAL(18, 2)
    ) AS [Total_Landed_Cost_USD],
    -- freight cost percentage of value calculation
    CAST(
        (TRY_CAST([Freight Cost (USD)] AS DECIMAL(18,2)) * 100.0) 
        / NULLIF([Line Item Value], 0) 
        AS DECIMAL(18, 2)
    ) AS [Freight_Cost_Percentage_Of_Value],
    -- total revenue calculation
    CAST(
        ([Line Item Quantity] * CAST([Pack Price] AS DECIMAL(18, 2))) 
        AS DECIMAL(18,2)
    ) AS [Revenues_USD],
    -- lead time calculation
    DATEDIFF(day, [PO Sent to Vendor Date], [Delivered to Client Date]) AS [Vendor_Lead_Time_Days],
    DATEDIFF(day, [Scheduled Delivery Date], [Delivered to Client Date]) AS [Delivery_Delay_Days]
FROM 
dbo.fact_table;
